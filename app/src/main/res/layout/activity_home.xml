<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bgColorCrema"
            android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="15dp">
            <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/visionlogo" />
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pantalla Home/Inicio"
                    android:textSize="16sp"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/black" />
        </LinearLayout>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="!BIENVENIDO!"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

        <TextView
                android:id="@+id/tvNombreHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de Usuario"
                android:textSize="24sp"
                android:textColor="@color/black"
                android:layout_marginBottom="15dp" />

        <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPerfilHome"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircularImageViewStyle"
                    android:src="@drawable/logodefecto" />

            <ImageView
                    android:id="@+id/ivGestionUsuario"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/logodefecto"
                    android:layout_alignBottom="@id/ivPerfilHome"
                    android:layout_alignEnd="@id/ivPerfilHome"
                    android:layout_marginEnd="-5dp"
                    android:layout_marginBottom="-5dp" />
        </RelativeLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="15dp">

            <TextView
                    android:id="@+id/tvTituloRango"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando Rango..."
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

            <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="25sp" />
                <TextView
                        android:id="@+id/tvEmojiFuego"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="14sp"
                        android:layout_gravity="top|end"
                        android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué desea realizar?"
                android:textSize="22sp"
                android:textColor="@color/black"
                android:layout_marginBottom="15dp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <LinearLayout
                    android:id="@+id/btnListado"
                    style="@style/BotonMenuHome">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LISTADO PRODUCTOS" android:textColor="@color/white" android:textStyle="bold" android:gravity="center" />
                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/logo_listado" />
            </LinearLayout>
            <View android:layout_width="15dp" android:layout_height="1dp" />
            <LinearLayout
                    android:id="@+id/btnEscanear"
                    style="@style/BotonMenuHome">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESCANEAR PRODUCTO" android:textColor="@color/white" android:textStyle="bold" android:gravity="center" />
                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/logo_escaneo" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:id="@+id/btnModoVision"
                style="@style/BotonMenuHomeAmarillo">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MODO VISION ++" android:textColor="@color/black" android:textSize="22sp" android:textStyle="bold" />
            <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/logo_visionplus" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <LinearLayout
                    android:id="@+id/btnPrismas"
                    style="@style/BotonMenuHome">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRISMAS ACUMULADOS" android:textColor="@color/white" android:textStyle="bold" android:gravity="center" />
                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/logo_prismas" />
            </LinearLayout>
            <View android:layout_width="15dp" android:layout_height="1dp" />
            <LinearLayout
                    android:id="@+id/btnDudas"
                    style="@style/BotonMenuHome">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DUDAS GENERALES" android:textColor="@color/white" android:textStyle="bold" android:gravity="center" />
                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/logo_dudas" />
            </LinearLayout>
        </LinearLayout>

        <Button
                android:id="@+id/btnSalir"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Salir Vision+"
                android:backgroundTint="@color/redSalir"
                android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>